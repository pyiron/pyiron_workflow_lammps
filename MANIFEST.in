# setuptools' defaults only pick up tests/test_*.py; graft the whole suite
# (conftest.py, unit/, integration/, benchmark/, fixtures/ data) so the sdist
# is testable on its own (the clean-install CI runs the sdist's tests/).
include LICENSE README.md CHANGELOG.md
graft tests
global-exclude __pycache__ *.py[cod]
global-exclude recovery.pckl recovery.cpckl
exclude pyiron.log
